// Secrets.example.xcconfig
//
// Template for Config/Secrets.xcconfig, which is gitignored and optional.
//
//   make secrets      # copies this file to Config/Secrets.xcconfig
//   make generate
//
// XAI_DEV_API_KEY: your personal xAI API key (https://console.x.ai). DEBUG
// builds copy it into the Keychain on first launch so you don't have to type
// it on the simulator. Leave it empty to enter the key in the app instead.
//
// A Release build (archives, and the Blau-Perf scheme when run from Xcode)
// FAILS while this is non-empty. `make perf` blanks it for you.
//
// Never commit Secrets.xcconfig and never paste a key into any other file.

XAI_DEV_API_KEY =
