# macOS
.DS_Store

# XcodeGen output: generated from project.yml, never committed
*.xcodeproj
Blau/Supporting/Info.plist
Blau/Supporting/*.entitlements
BlauWidgets/Supporting/Info.plist

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.xcresult

# Swift Package Manager / local build output
.build/
.swiftpm/

# Secrets (see Secrets.xcconfig handling)
Secrets.xcconfig

# Optional benchmark model and recording (see BlauBenchmarks/Assets/README.md)
BlauBenchmarks/Assets/*
!BlauBenchmarks/Assets/README.md

# Python bytecode (scripts/embeddings)
__pycache__/

# package-benchmark baselines (the committed gate is Packages/BlauKitBenchmarks/Thresholds)
.benchmarkBaselines/

# Personal XCTest perf baselines (make perf-baseline PERF_BASELINE=local-...); only CI ones are committed
BlauPerfTests/Baselines/local*.json
